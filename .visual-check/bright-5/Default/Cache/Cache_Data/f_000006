/* ================================================================
   GAME VIBE — Verification Command Center

   Final art-direction layer. This file intentionally loads after the
   responsive sheet: it only reskins existing components and repeats the
   compact breakpoints it touches. Game flow, DOM hooks and state are intact.
   ================================================================ */

:root{
  --gv-void:#020817;
  --gv-deep:#07132e;
  --gv-panel:#0b2250;
  --gv-cyan:#55e7ff;
  --gv-cyan-soft:rgba(85,231,255,.2);
  --gv-amber:#ffb52e;
  --gv-lime:#a8ff78;
  --gv-coral:#ff7b61;
  --gv-line:rgba(109,226,255,.28);
  --gv-line-hot:rgba(109,226,255,.62);
  --gv-font:"Chakra Petch","Segoe UI",sans-serif;
}

/* World: layered light, technical grid and a subtle scan pass. */
#app:not(.is-pre-game){
  isolation:isolate;
  background:
    radial-gradient(ellipse at 48% 45%,rgba(9,55,95,.12),transparent 44%),
    linear-gradient(180deg,rgba(1,7,21,.38),rgba(1,6,18,.75)),
    url("../assets/illustrations/media-command-center.png") center/cover no-repeat;
}

#app:not(.is-pre-game)::before{
  background:
    linear-gradient(rgba(68,211,255,.025) 1px,transparent 1px),
    linear-gradient(90deg,rgba(68,211,255,.025) 1px,transparent 1px),
    radial-gradient(ellipse at 50% 45%,rgba(20,158,210,.16),transparent 48%),
    linear-gradient(90deg,rgba(1,5,17,.58),transparent 18% 82%,rgba(1,5,17,.58));
  background-size:42px 42px,42px 42px,auto,auto;
  box-shadow:inset 0 0 150px rgba(0,3,14,.8);
  opacity:.92;
}

#app:not(.is-pre-game)::after{
  content:"";
  position:absolute;
  z-index:0;
  inset:0;
  pointer-events:none;
  background:
    linear-gradient(105deg,transparent 0 38%,rgba(77,219,255,.035) 46%,transparent 54% 100%),
    repeating-linear-gradient(0deg,transparent 0 5px,rgba(149,232,255,.018) 6px);
  mix-blend-mode:screen;
  animation:gv-scan-world 9s linear infinite;
}

@keyframes gv-scan-world{
  0%{background-position:-55vw 0,0 0}
  100%{background-position:65vw 0,0 0}
}

/* Mission frame: reads as an active console rather than a loose page. */
#app:not(.is-pre-game) .mission-workspace{
  isolation:isolate;
  filter:drop-shadow(0 28px 45px rgba(0,2,12,.26));
}

#app:not(.is-pre-game) .mission-head{
  position:relative;
  overflow:hidden;
  min-height:64px;
  border:1px solid var(--gv-line);
  border-left:4px solid var(--gv-amber);
  border-radius:12px 22px 12px 12px;
  background:
    linear-gradient(90deg,rgba(19,65,114,.94),rgba(7,24,59,.94) 58%,rgba(13,20,57,.94)),
    var(--gv-deep);
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.1),
    inset 0 -1px 0 rgba(85,231,255,.12),
    0 14px 32px rgba(0,3,15,.38),
    0 0 28px rgba(65,214,255,.07);
}

#app:not(.is-pre-game) .mission-head::before{
  content:"LIVE OPERATION";
  position:absolute;
  right:clamp(142px,13vw,196px);
  top:9px;
  font:700 .56rem/1 var(--gv-font);
  letter-spacing:.18em;
  color:rgba(126,239,255,.68);
}

#app:not(.is-pre-game) .mission-head::after{
  content:"";
  position:absolute;
  left:18px;
  right:18px;
  bottom:7px;
  height:2px;
  background:linear-gradient(90deg,var(--gv-amber) 0 10%,var(--gv-cyan) 10% 42%,transparent 72%);
  opacity:.65;
}

#app:not(.is-pre-game) .mission-head h2{
  position:relative;
  z-index:1;
  font-family:var(--gv-font);
  font-weight:700;
  letter-spacing:.015em;
  text-shadow:0 3px 14px rgba(0,0,0,.6),0 0 18px rgba(76,225,255,.1);
}

#app:not(.is-pre-game) .mission-progress{
  position:relative;
  z-index:2;
  min-height:36px;
  padding:7px 15px 7px 27px;
  border:1px solid rgba(99,232,255,.5);
  border-radius:9px 18px 18px 9px;
  background:linear-gradient(180deg,rgba(22,111,155,.74),rgba(5,45,88,.9));
  font-family:var(--gv-font);
  letter-spacing:.035em;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.16),0 0 20px rgba(85,231,255,.1);
}

#app:not(.is-pre-game) .mission-progress::before{
  content:"";
  position:absolute;
  left:11px;
  top:50%;
  width:7px;
  height:7px;
  border-radius:50%;
  background:var(--gv-lime);
  box-shadow:0 0 9px var(--gv-lime);
  transform:translateY(-50%);
  animation:gv-led 1.2s ease-in-out infinite alternate;
}

@keyframes gv-led{to{opacity:.45;box-shadow:0 0 3px var(--gv-lime)}}

/* Panels: translucent equipment bays with illuminated seams and corner marks. */
#app:not(.is-pre-game) .glass-panel{
  position:relative;
  border:1px solid rgba(91,224,255,.3);
  border-radius:20px;
  background:
    linear-gradient(90deg,var(--gv-cyan) 0 13%,var(--gv-amber) 13% 28%,transparent 28%) top left/100% 3px no-repeat,
    linear-gradient(135deg,rgba(18,57,105,.94),rgba(6,21,55,.96) 52%,rgba(16,19,61,.94));
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.11),
    inset 0 0 38px rgba(56,189,239,.035),
    0 0 0 4px rgba(1,11,29,.42),
    0 22px 50px rgba(0,3,15,.48),
    0 0 28px rgba(74,219,255,.07);
  backdrop-filter:blur(14px) saturate(1.08);
}

/* An inset engineering grid, kept beneath all panel content. */
#app:not(.is-pre-game) .glass-panel::before{
  content:"";
  position:absolute;
  z-index:0;
  inset:7px;
  border-radius:14px;
  pointer-events:none;
  background:
    linear-gradient(var(--gv-line-hot),var(--gv-line-hot)) left top/19px 1px no-repeat,
    linear-gradient(var(--gv-line-hot),var(--gv-line-hot)) left top/1px 19px no-repeat,
    linear-gradient(var(--gv-line-hot),var(--gv-line-hot)) right bottom/19px 1px no-repeat,
    linear-gradient(var(--gv-line-hot),var(--gv-line-hot)) right bottom/1px 19px no-repeat,
    repeating-linear-gradient(0deg,transparent 0 20px,rgba(89,219,255,.018) 21px);
  opacity:.72;
}

#app:not(.is-pre-game) .glass-panel > *{position:relative;z-index:1}

/* Shared typography makes screens feel like parts of one system. */
#app:not(.is-pre-game) :is(
  .clue-hunt-panel,.checks-unlocked-panel,.detector-rule-panel,
  .detector-test-panel,.final-decision-panel,.missing-tools-panel,
  .compact-intro-card,.sharing-commitment-panel,.completion-panel
) h3{
  color:#f8fcff;
  text-shadow:0 3px 15px rgba(0,0,0,.48),0 0 16px rgba(85,231,255,.08);
}

#app:not(.is-pre-game) :is(
  .clue-hunt-kicker,.commitment-kicker,.logic-story-chip,
  .v1-check-strip>small,.dual-answer-grid>div>small
){
  font-family:var(--gv-font);
  color:var(--gv-amber);
  letter-spacing:.16em;
}

/* Cards become console modules: live cyan edge, tactile lower rail. */
#app:not(.is-pre-game) :is(
  .choice-card,.source-card,.evidence-tile,.verdict-choice,.prediction-btn,
  .upgrade-check-card,.upgrade-option-card,.upgrade-missing-card,
  .clean-install-card,.missing-tool-card,.warning-prediction-card,
  .compact-answer-btn,.prototype-check-card,.orbit-check,.mini-check-result,
  .scan-result-row,.logic-check-module,.commitment-step,.completion-score-card
){
  border:1px solid rgba(99,218,255,.26);
  border-radius:14px;
  background:
    linear-gradient(90deg,rgba(75,224,255,.75),transparent 32%) top/100% 2px no-repeat,
    linear-gradient(145deg,rgba(27,68,126,.88),rgba(5,20,53,.94));
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.08),
    inset 0 -3px 0 rgba(1,8,24,.46),
    0 5px 0 rgba(1,8,24,.5),
    0 12px 24px rgba(0,3,15,.3);
}

#app:not(.is-pre-game) :is(
  .choice-card,.source-card,.evidence-tile,.verdict-choice,.prediction-btn,
  .upgrade-check-card,.upgrade-option-card,.upgrade-missing-card,
  .clean-install-card,.missing-tool-card,.warning-prediction-card,
  .compact-answer-btn,.prototype-check-card
):hover:not(:disabled):not(.is-selected){
  border-color:rgba(103,234,255,.7);
  background:
    linear-gradient(90deg,var(--gv-amber),var(--gv-cyan) 42%,transparent 70%) top/100% 3px no-repeat,
    linear-gradient(145deg,rgba(34,86,151,.95),rgba(6,25,61,.98));
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.12),
    0 5px 0 rgba(1,8,24,.52),
    0 0 0 2px rgba(83,224,255,.14),
    0 15px 28px rgba(0,3,15,.4),
    0 0 22px rgba(85,231,255,.1);
}

#app:not(.is-pre-game) :is(
  .choice-card,.source-card,.evidence-tile,.verdict-choice,.prediction-btn,
  .upgrade-check-card,.upgrade-option-card,.upgrade-missing-card,
  .clean-install-card,.missing-tool-card,.warning-prediction-card,
  .compact-answer-btn,.prototype-check-card
).is-selected{
  border-color:rgba(168,255,120,.72);
  background:
    linear-gradient(90deg,var(--gv-lime),var(--gv-cyan) 50%,transparent 75%) top/100% 3px no-repeat,
    linear-gradient(145deg,rgba(36,100,111,.96),rgba(6,32,55,.98));
  box-shadow:0 5px 0 rgba(1,8,24,.5),0 0 0 2px rgba(168,255,120,.18),0 0 25px rgba(168,255,120,.12);
}

/* Icon wells are lit pieces of hardware instead of flat tiles. */
#app:not(.is-pre-game) :is(
  .prototype-check-card>span,.upgrade-check-card>span,.upgrade-option-card>span,
  .missing-tool-card>span,.orbit-check>span,.source-card-icon,.evidence-tile-icon,
  .unlock-icon,.commitment-step>span,.completion-score-card>span
){
  border:1px solid rgba(106,231,255,.35);
  background:radial-gradient(circle at 35% 25%,rgba(117,241,255,.26),rgba(17,83,128,.2) 48%,rgba(4,20,51,.82));
  color:var(--gv-cyan);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.16),0 0 16px rgba(85,231,255,.09);
}

/* Primary actions: high-energy launch controls with a restrained sheen. */
#app:not(.is-pre-game) .btn-primary:not(:disabled){
  position:relative;
  overflow:hidden;
  border:2px solid #ffe3a4;
  border-radius:12px;
  background:linear-gradient(180deg,#ffc64f 0%,#ff9221 52%,#e65a0b 100%);
  font-family:var(--gv-font);
  letter-spacing:.055em;
  box-shadow:
    inset 0 2px 0 rgba(255,255,255,.38),
    inset 0 -4px 0 rgba(158,46,0,.3),
    0 0 0 3px rgba(4,25,57,.9),
    0 6px 0 3px rgba(1,9,24,.9),
    0 0 28px rgba(255,157,31,.2);
}

#app:not(.is-pre-game) .btn-primary:not(:disabled)::before{
  content:"";
  position:absolute;
  inset:-80% auto -80% -35%;
  width:24%;
  background:rgba(255,255,255,.3);
  transform:skewX(-18deg);
  transition:left .42s ease;
}

#app:not(.is-pre-game) .btn-primary:not(:disabled):hover::before{left:118%}

/* Byte communications use a distinct violet/cyan radio channel. */
#app:not(.is-pre-game) .byte-mini{gap:9px}
#app:not(.is-pre-game) .byte-mini-figure{
  border:1px solid rgba(92,231,255,.55);
  border-radius:12px;
  background:radial-gradient(circle at 50% 25%,rgba(85,231,255,.25),rgba(5,19,48,.9));
  box-shadow:0 0 0 3px rgba(3,16,40,.75),0 0 20px rgba(85,231,255,.13);
}

#app:not(.is-pre-game) .byte-line-panel{
  position:relative;
  border:1px solid rgba(137,112,255,.52);
  border-left:3px solid #9c86ff;
  border-radius:8px 14px 14px 8px;
  background:linear-gradient(100deg,rgba(23,21,69,.97),rgba(7,17,48,.94));
  box-shadow:inset 0 1px 0 rgba(255,255,255,.07),0 10px 22px rgba(0,3,15,.28),0 0 18px rgba(126,104,255,.07);
}

/* Clue hunt: notification queue becomes an active evidence feed. */
#app:not(.is-pre-game) .clue-hunt-panel .scan-progress{
  height:7px;
  border:1px solid rgba(107,230,255,.2);
  background:rgba(2,12,36,.72);
  box-shadow:inset 0 1px 4px rgba(0,0,0,.6);
}

#app:not(.is-pre-game) .clue-hunt-panel .scan-progress span{
  background:linear-gradient(90deg,var(--gv-amber),var(--gv-cyan),var(--gv-lime));
  box-shadow:0 0 10px rgba(85,231,255,.5);
}

#app:not(.is-pre-game) .unlock-slot{
  border-radius:12px;
  border:1px solid rgba(100,222,255,.28);
  background:linear-gradient(100deg,rgba(28,67,118,.86),rgba(6,22,56,.92));
  box-shadow:inset 3px 0 0 rgba(85,231,255,.58),0 8px 20px rgba(0,3,15,.32);
}

#app:not(.is-pre-game) .unlock-slot.is-locked{
  border-style:solid;
  border-color:rgba(112,160,196,.18);
  background:linear-gradient(100deg,rgba(31,50,82,.52),rgba(7,18,44,.72));
  box-shadow:inset 3px 0 0 rgba(99,136,174,.32);
  opacity:.72;
}

#app:not(.is-pre-game) .unlock-slot.is-unlocked{
  border-color:rgba(168,255,120,.56);
  background:linear-gradient(100deg,rgba(40,104,105,.72),rgba(6,31,55,.94));
  box-shadow:inset 3px 0 0 var(--gv-lime),0 0 22px rgba(168,255,120,.09),0 10px 24px rgba(0,3,15,.36);
}

/* Phone and detector stations sit on an illuminated dock. */
#app:not(.is-pre-game) :is(.mission-phone,.chat-phone-shell){
  filter:drop-shadow(0 28px 32px rgba(0,2,12,.56)) drop-shadow(0 0 16px rgba(64,219,255,.12));
}

#app:not(.is-pre-game) :is(.detector-core-panel,.phone-panel){
  background:
    radial-gradient(ellipse at 50% 82%,rgba(50,222,255,.18),transparent 42%),
    linear-gradient(135deg,rgba(17,55,103,.92),rgba(5,20,52,.96) 58%,rgba(15,18,57,.94));
}

#app:not(.is-pre-game) .detector-core-glow{
  background:rgba(61,224,255,.2);
  filter:blur(32px);
  animation:gv-core 1.8s ease-in-out infinite alternate;
}

@keyframes gv-core{to{transform:scale(1.12);opacity:.62}}

/* Build slots look wired and intentional, including empty states. */
#app:not(.is-pre-game) :is(.detector-load-slot,.builder-slot-chip){
  border-radius:11px;
  border-color:rgba(102,226,255,.36);
  background:rgba(3,17,46,.62);
  box-shadow:inset 0 0 18px rgba(56,204,255,.04),0 4px 12px rgba(0,3,15,.24);
}

#app:not(.is-pre-game) :is(.detector-load-slot.is-filled,.builder-slot-chip.is-active){
  border-color:rgba(168,255,120,.58);
  background:linear-gradient(145deg,rgba(32,108,111,.54),rgba(4,27,51,.86));
  box-shadow:inset 0 0 18px rgba(168,255,120,.06),0 0 16px rgba(168,255,120,.08);
}

/* Test lab: a connected three-step protocol, not disconnected pills. */
#app:not(.is-pre-game) .test-step-strip{
  position:relative;
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:5px;
  padding:4px;
  border:1px solid rgba(92,220,255,.2);
  border-radius:10px;
  background:rgba(2,14,41,.58);
}

#app:not(.is-pre-game) .test-step-strip span{
  display:grid;
  place-items:center;
  border:0;
  border-radius:7px;
  background:transparent;
  color:rgba(192,210,231,.62);
  font-family:var(--gv-font);
}

#app:not(.is-pre-game) .test-step-strip .is-on{
  background:linear-gradient(180deg,rgba(33,136,175,.62),rgba(12,65,111,.72));
  color:#dcfbff;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.12),0 0 14px rgba(85,231,255,.1);
}

#app:not(.is-pre-game) .scan-result-row{
  box-shadow:inset 3px 0 0 rgba(85,231,255,.5),0 5px 0 rgba(1,8,24,.4),0 10px 18px rgba(0,3,15,.24);
}

/* Feedback is an unmistakable system status readout. */
#app:not(.is-pre-game) .inline-feedback{
  border-radius:10px;
  border-left-width:4px;
  background:linear-gradient(100deg,rgba(15,40,80,.94),rgba(4,18,48,.9));
  box-shadow:inset 0 1px 0 rgba(255,255,255,.05),0 8px 18px rgba(0,3,15,.25);
}

#app:not(.is-pre-game) .inline-feedback.is-correct{box-shadow:inset 4px 0 0 var(--gv-lime),0 8px 18px rgba(0,3,15,.25)}
#app:not(.is-pre-game) .inline-feedback.is-retry{box-shadow:inset 4px 0 0 var(--gv-coral),0 8px 18px rgba(0,3,15,.25)}
#app:not(.is-pre-game) .inline-feedback.is-neutral{box-shadow:inset 4px 0 0 var(--gv-cyan),0 8px 18px rgba(0,3,15,.25)}

/* Unlock and final screens get a focal glow so milestones feel earned. */
#app:not(.is-pre-game) :is(.checks-unlocked-panel,.compact-intro-card,.completion-panel){
  background:
    radial-gradient(circle at 50% 35%,rgba(67,218,255,.15),transparent 36%),
    linear-gradient(135deg,rgba(18,58,106,.95),rgba(6,21,55,.97) 58%,rgba(18,19,64,.95));
}

#app:not(.is-pre-game) .orbit-check{
  min-height:clamp(112px,18vh,158px);
}

#app:not(.is-pre-game) .orbit-check.is-new{
  border-color:rgba(255,181,46,.6);
  background:
    linear-gradient(90deg,var(--gv-amber),var(--gv-cyan) 60%,transparent) top/100% 3px no-repeat,
    linear-gradient(145deg,rgba(50,75,117,.92),rgba(8,21,54,.96));
  box-shadow:0 5px 0 rgba(1,8,24,.5),0 0 25px rgba(255,181,46,.1);
}

#app:not(.is-pre-game) .final-shield-visual,
#app:not(.is-pre-game) .completion-badge{
  filter:drop-shadow(0 0 18px rgba(85,231,255,.28));
}

/* HUD integrates with the new world instead of floating above it. */
#app:not(.is-pre-game) .hud-brand,
#app:not(.is-pre-game) .hud-topright,
#app:not(.is-pre-game) .hud-progress{
  filter:drop-shadow(0 8px 14px rgba(0,3,15,.5)) drop-shadow(0 0 7px rgba(85,231,255,.07));
}

#app:not(.is-pre-game) .game-bottom-nav::before{
  content:"";
  position:absolute;
  left:50%;
  bottom:0;
  width:min(600px,48vw);
  height:90px;
  transform:translateX(-50%);
  pointer-events:none;
  background:radial-gradient(ellipse at 50% 100%,rgba(45,205,255,.14),transparent 68%);
}

/* Byte introduction receives the same command-channel treatment. */
.byte-intro-scene{
  background:
    linear-gradient(rgba(77,218,255,.024) 1px,transparent 1px),
    linear-gradient(90deg,rgba(77,218,255,.024) 1px,transparent 1px),
    radial-gradient(circle at 35% 45%,rgba(55,211,255,.14),transparent 34%);
  background-size:42px 42px,42px 42px,auto;
}

.byte-intro-card{
  border:1px solid rgba(94,225,255,.38);
  border-radius:20px;
  background:
    linear-gradient(90deg,var(--gv-cyan),var(--gv-amber) 25%,transparent 25%) top/100% 3px no-repeat,
    linear-gradient(135deg,rgba(17,57,106,.96),rgba(6,20,53,.97) 58%,rgba(17,18,62,.95));
  box-shadow:0 0 0 4px rgba(2,12,31,.45),0 24px 54px rgba(0,3,15,.48),0 0 34px rgba(85,231,255,.08);
}

.byte-intro-figure{
  border-radius:18px;
  border-color:rgba(87,230,255,.62);
  background:radial-gradient(circle at 50% 25%,rgba(86,231,255,.22),rgba(5,18,48,.94));
  box-shadow:0 0 0 4px rgba(2,13,34,.6),0 20px 42px rgba(0,3,15,.4),0 0 26px rgba(85,231,255,.16);
}

/* Compact landscape keeps the atmosphere without sacrificing game content. */
@media (max-height:700px) and (orientation:landscape){
  #app:not(.is-pre-game)::before{background-size:34px 34px,34px 34px,auto,auto}
  #app:not(.is-pre-game) .mission-head::before{display:none}
  #app:not(.is-pre-game) .mission-head::after{bottom:5px}
  #app:not(.is-pre-game) .glass-panel{border-radius:15px}
  #app:not(.is-pre-game) .glass-panel::before{inset:5px;border-radius:10px}
  #app:not(.is-pre-game) :is(.orbit-check,.mini-check-result,.scan-result-row){border-radius:10px}

  /* The legacy upgrade picker was sized from the full viewport. Inside the
     HUD safe area that made the workspace taller than its stage and centred
     its title behind the top-left plate. Let the panel flex inside play space. */
  #app:not(.is-pre-game) #scene-chunk6 .mission-workspace{
    height:100%;
    max-height:100%;
    min-height:0;
    justify-content:flex-start;
    overflow:hidden;
  }
  #app:not(.is-pre-game) #scene-chunk6 .corrected-upgrade-panel{
    flex:1 1 auto;
    height:auto;
    max-height:none;
    min-height:0;
    padding:7px 12px;
    gap:5px;
  }
  #app:not(.is-pre-game) #scene-chunk6 .corrected-upgrade-panel>h3{font-size:1.35rem}
  #app:not(.is-pre-game) #scene-chunk6 .upgrade-byte-guidance .byte-mini-figure{
    width:38px;
    height:42px;
    min-height:42px;
    flex-basis:38px;
  }
  #app:not(.is-pre-game) #scene-chunk6 .upgrade-byte-guidance .byte-line-panel{
    min-height:40px;
    padding:5px 8px;
  }
  #app:not(.is-pre-game) #scene-chunk6 .distractor-option-grid{gap:6px}
  #app:not(.is-pre-game) #scene-chunk6 .distractor-option-grid .upgrade-option-card{
    min-height:48px;
    padding:4px 8px;
  }
  #app:not(.is-pre-game) #scene-chunk6 .corrected-upgrade-panel .upgrade-choice-feedback{
    min-height:40px;
    padding:5px 8px;
